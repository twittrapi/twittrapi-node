{
  "name": "twittrapi",
  "version": "0.2.1",
  "description": "Node.js and TypeScript SDK for TwittrAPI: read public Twitter/X tweets, profiles, followers and search results. Pay as you go from $0.065 per 1,000 calls.",
  "license": "MIT",
  "author": "TwittrAPI",
  "homepage": "https://twittrapi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twittrapi/twittrapi-node.git"
  },
  "bugs": {
    "url": "https://github.com/twittrapi/twittrapi-node/issues"
  },
  "keywords": [
    "twitter api",
    "x api",
    "twitter scraper",
    "tweets",
    "twitter search",
    "twitter followers",
    "social media data",
    "twittrapi",
    "sdk",
    "nodejs",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/clean.mjs build-test && tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke.cjs",
    "prepublishOnly": "npm test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "typescript": "6.0.3"
  }
}
